            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"+8801711000001\",\n  \"otp_code\": \"{{otpCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp", "verify"]
            }
          }
