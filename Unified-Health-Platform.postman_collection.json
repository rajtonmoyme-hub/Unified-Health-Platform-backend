            "body": {
              "mode": "raw",
              "raw": "{\n  \"all_devices\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
