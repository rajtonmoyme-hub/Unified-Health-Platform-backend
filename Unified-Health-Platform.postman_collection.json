    {
      "name": "4. Auth — Sessions & Remote Logout (Section 7.3)",
      "item": [
        {
          "name": "4.1 List Active Device Sessions (/auth/sessions)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "if (res.data && Array.isArray(res.data) && res.data.length > 0) {",
                  "  pm.collectionVariables.set('sessionId', String(res.data[0].id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sessions"]
            }
          }
        },
        {
          "name": "4.2 Revoke Specific Session by ID (/auth/sessions/:sessionId)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sessions", "{{sessionId}}"]
            }
          }
        },
        {
          "name": "4.3 Logout Current Device (/auth/logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
