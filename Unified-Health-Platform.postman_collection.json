  "item": [
    {
      "name": "1. Auth — Registration & Mobile OTP (FR-1.1, FR-1.2)",
      "item": [
        {
          "name": "1.1 Register New Patient (Auto-saves JWT & OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "if (res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}",
                  "if (res.data && res.data.dev_otp) {",
                  "  pm.collectionVariables.set('otpCode', res.data.dev_otp);",
                  "}",
                  "if (res.data && res.data.user && res.data.user.patient_profile) {",
                  "  pm.collectionVariables.set('healthId', res.data.user.patient_profile.health_id);",
                  "}",
                  "if (res.data && res.data.session && res.data.session.id) {",
                  "  pm.collectionVariables.set('sessionId', String(res.data.session.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"+8801711998877\",\n  \"email\": \"farhana.patient@rogisathi.bd\",\n  \"password\": \"Password123!\",\n  \"full_name\": \"Farhana Yasmin\",\n  \"nid_number\": \"1995269045112\",\n  \"role\": \"patient\",\n  \"date_of_birth\": \"1995-08-20\",\n  \"gender\": \"Female\",\n  \"blood_group\": \"B+\",\n  \"emergency_contact\": \"+8801711998800\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Send Mobile OTP (Auto-saves otpCode)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
