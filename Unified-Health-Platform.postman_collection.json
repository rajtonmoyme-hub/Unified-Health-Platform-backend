                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}",
                  "if (res.data && res.data.session && res.data.session.id) {",
                  "  pm.collectionVariables.set('sessionId', String(res.data.session.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
