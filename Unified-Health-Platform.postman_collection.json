                  "  pm.collectionVariables.set('otpCode', res.data.dev_otp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"+8801711000001\",\n  \"purpose\": \"login\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp", "send"]
            }
          }
        },
        {
          "name": "1.3 Verify Mobile OTP & Issue JWT (Auto-saves JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
