{
  "name": "unified-health-platform-backend",
  "version": "0.1.0",
  "description": "Express.js backend for Unified Health Platform (Rogi Sathi)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:start": "\"%LOCALAPPDATA%\\Programs\\PostgreSQL\\bin\\pg_ctl.exe\" -D \"%LOCALAPPDATA%\\Programs\\PostgreSQL\\data\" -l \"%LOCALAPPDATA%\\Programs\\PostgreSQL\\postgres.log\" start",
    "db:stop": "\"%LOCALAPPDATA%\\Programs\\PostgreSQL\\bin\\pg_ctl.exe\" -D \"%LOCALAPPDATA%\\Programs\\PostgreSQL\\data\" stop"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
